# Copy to .env.local and fill in. Never commit .env.local.

# Anthropic API — server-side only, must never reach the browser.
# Create at console.anthropic.com, add billing, then set a hard monthly spend cap.
ANTHROPIC_API_KEY=

# Confirm the current model identifier against
# https://docs.claude.com/en/api/overview — do not hardcode one from memory.
# Checked 14 Sept 2026: claude-opus-5 is current. Left blank, the app uses that.
ANTHROPIC_MODEL=

# How hard the model works on each reply: low, medium, high, xhigh or max.
# Higher is slower. Blank means medium, which keeps a reply inside a serverless
# function's time limit while still giving a considered pack check.
ASSISTANT_EFFORT=

# Single shared password for both users, checked in proxy.ts.
APP_PASSWORD=

# Postgres — Vercel Postgres or Neon. Use the pooled connection string, and make
# sure it carries ?sslmode=require.
DATABASE_URL=

# Caps on the assistant route, so a shared password in front of an API key
# cannot run up a bill nobody is watching. Raise if she hits them.
ASSISTANT_DAILY_MESSAGE_CAP=200
ASSISTANT_SESSION_MESSAGE_CAP=50
